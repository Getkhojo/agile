# Copy to .env and fill in. .env is gitignored.

# Required: a long random string. Needed to read leads (GET /api/leads).
# Generate one with: openssl rand -hex 24
ATE_ADMIN_TOKEN=

# Public form rate limit (per IP)
ATE_RATE_MAX=5
ATE_RATE_WINDOW=600

# --- AI assistant providers ---
# Tried in this order; first one that answers wins. Options: nvidia, openai, gemini
AI_PROVIDERS=nvidia,gemini
ATE_ASSIST_MAX_WORDS=40

# NVIDIA (free, OpenAI-compatible). Key from build.nvidia.com, starts with nvapi-
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenAI (optional, paid). Add "openai" to AI_PROVIDERS to use it.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Gemini ---
# Leave GEMINI_API_KEY blank to keep the free built-in (rule-based) answers.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-flash-latest always tracks the current Flash model (no deprecation surprises).
# You can pin a specific one instead, e.g. gemini-3.8-flash.
GEMINI_MODEL=gemini-flash-latest
ATE_ASSIST_MAX=20
ATE_ASSIST_WINDOW=600

# --- Lead alerts (both optional; leads are saved + logged regardless) ---
# Telegram: free and instant. Create a bot with @BotFather, get the token;
# message the bot once, then get your chat id from @userinfobot.
TG_BOT_TOKEN=
TG_CHAT_ID=

# Email (SMTP). Leave SMTP_HOST blank to skip email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=info@agiletechexpert.com
ATE_NOTIFY_TO=aviatankit@gmail.com

# --- Real-time website voice (Gemini Live, audio-to-audio) ---
# Uses GEMINI_API_KEY unless VOICE_API_KEY is set. Set VOICE_ENABLED=0 to force the free browser voice.
VOICE_ENABLED=1
VOICE_MODEL=gemini-3.8-live
VOICE_MALE=Charon
VOICE_FEMALE=Kore
VOICE_DEFAULT_GENDER=female
# Persona names and greeting (greeting is built from the name unless set)
VOICE_NAME_FEMALE=Vidhi
VOICE_NAME_MALE=Aarav
# VOICE_GREETING_FEMALE=Namaste! Hi, main Vidhi...
# Emotion-aware replies; turn on only if voice_check.py says SUPPORTED
VOICE_AFFECTIVE=0
# Turn-taking: silence (ms) before Agile answers. Lower = faster, too low = cuts the visitor off.
VOICE_SILENCE_MS=400
VOICE_VAD_TUNING=1
# Cost guards
VOICE_MAX_SECONDS=180
VOICE_IDLE_SECONDS=20
VOICE_MAX_CONCURRENT=3
VOICE_PER_IP_HOUR=10
VOICE_DAILY_MINUTES=60
VOICE_ALLOWED_ORIGINS=https://agiletechexpert.com,https://www.agiletechexpert.com
