# Copy to .env and fill in. .env is gitignored.

# Required: a long random string. Needed to read leads (GET /api/leads).
# Generate one with: openssl rand -hex 24
ATE_ADMIN_TOKEN=

# Rate limit for the public form (per IP)
ATE_RATE_MAX=5
ATE_RATE_WINDOW=600

# Optional email notification for each new lead.
# Leave SMTP_HOST empty to skip email — leads are still saved and logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=info@agiletechexpert.com
ATE_NOTIFY_TO=aviatankit@gmail.com
