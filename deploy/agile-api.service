[Unit]
Description=Agile Tech Expert leads API
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/agiletechexpert/backend
EnvironmentFile=-/var/www/agiletechexpert/backend/.env
ExecStart=/var/www/agiletechexpert/backend/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
